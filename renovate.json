{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "Minor and patch updates arrive as one PR per place they ship, so each PR has one deploy step. Majors keep a PR each.",
    "extends": ["config:recommended"],
    "schedule": ["on monday"],
    "timezone": "Europe/London",
    "minimumReleaseAge": "3 days",
    "prHourlyLimit": 0,
    "prConcurrentLimit": 0,
    "rangeStrategy": "bump",
    "vulnerabilityAlerts": {
        "groupName": "Security"
    },
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": ["on monday"]
    },
    "packageRules": [
        {
            "description": "The Playground ships when Netlify deploys the merge.",
            "matchFileNames": [
                "packages/bdt-astro/**",
                "packages/bdt-components/**",
                "packages/*-fetcher/**",
                "packages/types/**",
                "packages/data-wranglers/**"
            ],
            "matchUpdateTypes": ["minor", "patch", "digest"],
            "groupName": "Playground"
        },
        {
            "description": "The Writers' Lambdas ship with cdk deploy.",
            "matchFileNames": ["packages/bdt-cdk/**", "packages/overcast/**"],
            "matchUpdateTypes": ["minor", "patch", "digest"],
            "groupName": "Writers"
        },
        {
            "description": "The WordPress plugin ships when a site pins the new commit.",
            "matchFileNames": ["packages/bdt-customisations/**"],
            "matchUpdateTypes": ["minor", "patch", "digest"],
            "groupName": "Plugin"
        },
        {
            "description": "Build, lint, test and CI tooling runs only in CI, so green checks cover it.",
            "matchFileNames": ["package.json", ".github/workflows/**", ".nvmrc"],
            "matchUpdateTypes": ["minor", "patch", "digest"],
            "groupName": "Tooling"
        },
        {
            "description": "GitHub Actions majors join Tooling too: they run only in CI, so a failing check is the whole risk.",
            "matchManagers": ["github-actions"],
            "matchDepTypes": ["action"],
            "separateMajorMinor": false,
            "groupName": "Tooling"
        }
    ]
}
