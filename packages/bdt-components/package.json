{
  "name": "@tdee/bdt-components",
  "version": "1.0.0",
  "description": "Component Library for BreakfastDinnerTea common assets",
  "repository": "https://github.com/SimonS/tdee-plaything",
  "license": "MIT",
  "private": true,
  "scripts": {
    "storybook": "storybook dev -c .storybook",
    "build-storybook": "storybook build -c .storybook -o ../bdt-astro/dist/storybook",
    "build": "pnpm build:esm && pnpm build:cjs",
    "build:esm": "tsc",
    "build:cjs": "tsc --module commonjs --outDir lib/cjs",
    "test": "jest"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@storybook/addon-actions": "^8.6.16",
    "@storybook/addon-controls": "^8.6.16",
    "@storybook/addon-docs": "^8.6.16",
    "@storybook/addon-links": "^8.6.16",
    "@storybook/addon-webpack5-compiler-babel": "^3.0.6",
    "@storybook/react": "^8.6.16",
    "@storybook/react-webpack5": "^8.6.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "assert-browserify": "^2.0.0",
    "babel-jest": "^29.7.0",
    "babel-loader": "^10.0.0",
    "css-loader": "^7.1.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "path-browserify": "^1.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resize-observer-polyfill": "^1.5.1",
    "sass-loader": "^16.0.7",
    "storybook": "^8.6.16",
    "style-loader": "^4.0.0",
    "typescript": "^5.9.3",
    "webpack": "^5.105.2"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webpack": "*"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest-setup.ts"
    ],
    "moduleNameMapper": {
      "\\.css$": "identity-obj-proxy"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!\\.pnpm/|nanostores|@nanostores|@nivo|d3-*|internmap|delaunator|robust-predicates).*/"
    ]
  },
  "dependencies": {
    "@nanostores/react": "^1.0.0",
    "@nivo/calendar": "^0.99.0",
    "@nivo/colors": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "date-fns": "^4.1.0",
    "jest-environment-jsdom": "^30.2.0",
    "nanostores": "^1.1.0",
    "react-day-picker": "^9.13.2",
    "recharts": "^2.15.4"
  }
}