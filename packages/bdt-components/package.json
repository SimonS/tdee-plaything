{
  "name": "@tdee/bdt-components",
  "version": "1.0.0",
  "description": "Component Library for BreakfastDinnerTea common assets",
  "repository": "https://github.com/SimonS/tdee-plaything",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "pnpm build:esm && pnpm build:cjs",
    "build:esm": "tsc",
    "build:cjs": "tsc --module commonjs --outDir lib/cjs",
    "test": "jest"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "assert-browserify": "^2.0.0",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "css-loader": "^7.1.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "path-browserify": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resize-observer-polyfill": "^1.5.1",
    "sass-loader": "^16.0.8",
    "style-loader": "^4.0.0",
    "typescript": "^5.9.3",
    "webpack": "^5.113.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest-setup.ts"
    ],
    "moduleNameMapper": {
      "\\.css$": "identity-obj-proxy"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!\\.pnpm/|nanostores|@nanostores|@nivo|d3-*|internmap|delaunator|robust-predicates).*/"
    ]
  },
  "dependencies": {
    "@nanostores/react": "^1.1.0",
    "@nivo/calendar": "^0.99.0",
    "@nivo/colors": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "date-fns": "^4.4.0",
    "jest-environment-jsdom": "^30.5.2",
    "nanostores": "^1.5.5",
    "react-day-picker": "^9.14.0",
    "recharts": "^3.11.0"
  }
}