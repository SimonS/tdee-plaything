{
  "name": "unnamed-tdee-app",
  "version": "0.0.1",
  "description": "Managing weightloss, I am currently using a spreadsheet found on reddit, I'd like to evolve that into a useful set of tools. Maybe eventually taking that data away from Google.",
  "main": "index.js",
  "repository": "https://github.com/simons/unnamed-tdee-app",
  "author": "Simon Scarfe",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "lint": "eslint .",
    "test": "jest && pnpm --filter @tdee/bdt-components test && pnpm --filter @tdee/bdt-cdk test",
    "test:integration": "jest --testRegex=\"(/__tests__/.*|(\\.|/)(integration))\\.tsx?$\"",
    "test:coverage": "jest --coverage",
    "deploy-all": "pnpm --filter @tdee/bdt-astro build",
    "compile": "tsc",
    "build:lambda": "netlify-lambda build packages/netlify-functions"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/aws-lambda": "^8.10.163",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^30.2.0",
    "prettier": "^3.8.3",
    "prop-types": "^15.8.1",
    "ts-jest": "^29.4.9",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "webpack": "^5.105.2"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser": "5.7.0"
    }
  }
}